{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true, "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true, "types": ["node"]
