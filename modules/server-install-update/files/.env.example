# Copy to .env and change what you need. Everything is optional.

# The folder that holds the library. Use the absolute path of the folder your old server used, to keep everything.
TURBOMUSIC_DATA=./data

# The access token. Leave blank to keep the one stored in the data folder (or have one made).
TURBOMUSIC_TOKEN=

# 127.0.0.1 = only this machine (and the tunnel) can reach the server; 0.0.0.0 = your whole network too.
TURBOMUSIC_BIND=0.0.0.0

# Only with:  docker compose --profile tunnel up -d
TUNNEL_TOKEN=
