{
  "appId": "app.musiccurator.frontend",
  "productName": "TurboMusic App",
  "directories": {
    "output": "release/app",
    "buildResources": "build"
  },
  "files": [
    "dist/**",
    "package.json"
  ],
  "extraMetadata": {
    "name": "music-curator-app",
    "desktopName": "music-curator-app.desktop",
    "curatorEdition": "app",
    "description": "TurboMusic app only: the window, with the library on a server you connect"
  },
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web"
    }
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "TurboNZL",
      "repo": "turbomusic",
      "releaseType": "release",
      "channel": "app"
    }
  ],
  "artifactName": "turbomusic-app-${version}-${os}-${arch}.${ext}",
  "linux": {
    "target": [
      "AppImage",
      "deb"
    ],
    "category": "Audio",
    "icon": "build/icon.png",
    "executableName": "music-curator-app",
    "maintainer": "TurboMusic <noreply@musiccurator.app>",
    "synopsis": "Personal music library and ranking",
    "desktop": {
      "entry": {
        "StartupWMClass": "music-curator-app"
      }
    }
  },
  "deb": {
    "packageName": "music-curator-app",
    "artifactName": "turbomusic-app-${version}-linux-${arch}.${ext}"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsis": {
    "artifactName": "turbomusic-app-${version}-windows-${arch}-setup.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  }
}
