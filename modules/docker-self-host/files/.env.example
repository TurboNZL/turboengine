# Copy to .env (docker compose reads it). Everything here is optional.

# The port on this machine (the left side of the published port). Every program on one machine needs its own: 47901 is TurboKeep's.
TURBOKEEP_PORT=47901

# Who can reach it: 0.0.0.0 = any device on your network (the default), 127.0.0.1 = this machine only. Use 127.0.0.1 once the Cloudflare tunnel works,
# because then nothing else needs to reach the port directly.
TURBOKEEP_BIND=0.0.0.0

# Only for the Cloudflare tunnel (docker compose --profile tunnel up -d): the token from Zero Trust > Networks > Tunnels.
TUNNEL_TOKEN=
